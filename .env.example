# Copy to .env before the first start:
#   cp .env.example .env
#
# Do not give this repository to players. It contains the organizer password
# and the codes the challenges are generated from.

SECRET_KEY=replace-with-a-long-random-string
TOKEN_SECRET=replace-with-another-long-random-string

CTFD_URL=http://localhost:8000
SCENARIO_URL=http://localhost:8080
SCOREBOARD_URL=http://localhost:8000

CTFD_ADMIN_USER=organizer
CTFD_ADMIN_EMAIL=ctf-admin@example.com
CTFD_ADMIN_PASSWORD=ClubSweep-ChangeMe

# Digits only, 4 to 8 characters. Change both, then recreate the stack and re-seed.
DOOR_CODE=246813
DISARM_CODE=903177
DOOR_FLAG=flag{door_is_open}
DISARM_FLAG=flag{building_is_safe}

# Closet rules. The scoreboard text is rewritten to match when you re-seed.
TRIES=3
SECONDS=300
